# Local iteration only: reuse compiled, locked dependencies from an inspected
# task-owned provider builder. Final qualification still needs a clean build.
ARG BUILD_CACHE_IMAGE
ARG RUNTIME_IMAGE
FROM ${BUILD_CACHE_IMAGE} AS build
WORKDIR /next-source
COPY . .
ENV CARGO_BUILD_JOBS=2 CARGO_TARGET_DIR=/source/target
RUN test -f Cargo.lock && cargo +1.98.1 build --locked --release \
    -p llull-buzz-provider --bin llull-buzz-provider
RUN mkdir -p /image/opt/llull/bin /image/usr/share/doc/llull-buzz && \
    cp /source/target/release/llull-buzz-provider /image/opt/llull/bin/ && \
    cp LICENSE Cargo.lock /image/usr/share/doc/llull-buzz/ && \
    sha256sum /image/opt/llull/bin/llull-buzz-provider > /image/usr/share/doc/llull-buzz/SHA256SUMS && \
    cargo metadata --locked --format-version 1 > /image/usr/share/doc/llull-buzz/cargo-metadata.json
FROM ${RUNTIME_IMAGE}
ARG SOURCE_SHA
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 65532 buzz && \
    useradd --uid 65532 --gid 65532 --no-create-home --home-dir /work/task/home buzz && \
    mkdir -p /work/task && chown 65532:65532 /work/task && chmod 700 /work/task
COPY --from=build /image/ /
LABEL org.opencontainers.image.source="https://github.com/jjjjguevara/llull-buzz" \
    org.opencontainers.image.revision="${SOURCE_SHA}"
USER 65532:65532
WORKDIR /work/task
ENTRYPOINT ["/opt/llull/bin/llull-buzz-provider"]
CMD ["--help"]
