{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.llull.invalid/buzz/bz-wire-v1",
  "title": "Proposed Buzz initial command definitions; not runtime conformance",
  "$ref": "#/$defs/command",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource": {"type": "object", "additionalProperties": false, "required": ["namespace", "ref", "revision"], "properties": {"namespace": {"$ref": "#/$defs/id"}, "ref": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}}},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "profile", "consumer_id", "intent_id", "operation", "resource", "correlation_id", "causation_id", "payload"],
      "properties": {
        "contract": {"const": "llull-buzz integration v0.2"},
        "profile": {"const": "bz-restricted-2026-09/v1"},
        "consumer_id": {"$ref": "#/$defs/id"}, "intent_id": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["enroll", "prove-key", "change-access", "intake", "start-task", "cancel-task", "reconcile-task", "publish", "ack-observations"]},
        "resource": {"$ref": "#/$defs/resource"}, "correlation_id": {"$ref": "#/$defs/id"}, "causation_id": {"$ref": "#/$defs/id"}, "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"operation": {"const": "enroll"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/enroll"}}}},
        {"if": {"properties": {"operation": {"const": "prove-key"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/proveKey"}}}},
        {"if": {"properties": {"operation": {"const": "change-access"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/changeAccess"}}}},
        {"if": {"properties": {"operation": {"const": "intake"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/intake"}}}},
        {"if": {"properties": {"operation": {"const": "start-task"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/task"}}}},
        {"if": {"properties": {"operation": {"enum": ["cancel-task", "reconcile-task"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/taskControl"}}}},
        {"if": {"properties": {"operation": {"const": "publish"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/publication"}}}},
        {"if": {"properties": {"operation": {"const": "ack-observations"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/ack"}}}}
      ]
    },
    "enroll": {"type": "object", "additionalProperties": false, "required": ["issuer", "subject", "intended_public_key", "community_id", "module_id", "browser_transaction_id"], "properties": {"issuer": {"type": "string", "format": "uri"}, "subject": {"$ref": "#/$defs/id"}, "intended_public_key": {"$ref": "#/$defs/digest"}, "community_id": {"$ref": "#/$defs/id"}, "module_id": {"$ref": "#/$defs/id"}, "browser_transaction_id": {"$ref": "#/$defs/id"}}},
    "nativeEvent": {"type": "object", "additionalProperties": false, "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"], "properties": {"id": {"$ref": "#/$defs/digest"}, "pubkey": {"$ref": "#/$defs/digest"}, "created_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "kind": {"type": "integer", "minimum": 0, "maximum": 65535}, "tags": {"type": "array", "maxItems": 128, "items": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 4096}}}, "content": {"type": "string", "maxLength": 16384}, "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$"}}},
    "proveKey": {"type": "object", "additionalProperties": false, "required": ["enrollment_id", "native_event"], "properties": {"enrollment_id": {"$ref": "#/$defs/id"}, "native_event": {"$ref": "#/$defs/nativeEvent"}}},
    "changeAccess": {"type": "object", "additionalProperties": false, "required": ["enrollment_id", "expected_revision", "change"], "properties": {"enrollment_id": {"$ref": "#/$defs/id"}, "expected_revision": {"$ref": "#/$defs/id"}, "change": {"enum": ["revoke", "restore"]}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "sha256", "media_type", "size_bytes", "release_ref"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}, "media_type": {"type": "string", "minLength": 1, "maxLength": 255}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 26214400}, "release_ref": {"$ref": "#/$defs/id"}}},
    "intake": {"type": "object", "additionalProperties": false, "required": ["event_id", "community_id", "channel_id", "content_sha256", "evidence"], "properties": {"event_id": {"$ref": "#/$defs/digest"}, "community_id": {"$ref": "#/$defs/id"}, "channel_id": {"$ref": "#/$defs/id"}, "content_sha256": {"$ref": "#/$defs/digest"}, "evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["schema_id", "schema_sha256", "action", "resources"], "properties": {"schema_id": {"$ref": "#/$defs/id"}, "schema_sha256": {"$ref": "#/$defs/digest"}, "action": {"$ref": "#/$defs/id"}, "resources": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/resource"}}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["model_attempts", "tool_admissions", "input_tokens_per_generation", "input_tokens_total", "output_tokens_total", "usd_micros", "automatic_restarts"], "properties": {"model_attempts": {"type": "integer", "minimum": 1, "maximum": 8}, "tool_admissions": {"type": "integer", "minimum": 1, "maximum": 32}, "input_tokens_per_generation": {"type": "integer", "minimum": 1, "maximum": 32000}, "input_tokens_total": {"type": "integer", "minimum": 1, "maximum": 128000}, "output_tokens_total": {"type": "integer", "minimum": 1, "maximum": 16000}, "usd_micros": {"type": "integer", "minimum": 1, "maximum": 1000000}, "automatic_restarts": {"type": "integer", "minimum": 0, "maximum": 3}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "root_task_id", "task_schema_id", "context_domain", "model_profile", "expires_at", "tools", "budgets", "verdict_refs"], "properties": {"task_id": {"$ref": "#/$defs/id"}, "root_task_id": {"$ref": "#/$defs/id"}, "task_schema_id": {"$ref": "#/$defs/id"}, "context_domain": {"$ref": "#/$defs/id"}, "model_profile": {"const": "sonnet-5-adaptive-bounded-v1"}, "expires_at": {"type": "string", "format": "date-time"}, "tools": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/tool"}}, "budgets": {"$ref": "#/$defs/budgets"}, "verdict_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "taskControl": {"type": "object", "additionalProperties": false, "required": ["task_id", "expected_generation", "reason"], "properties": {"task_id": {"$ref": "#/$defs/id"}, "expected_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "reason": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["community_id", "channel_id", "audience_policy", "audience_revision", "release_ref", "text", "text_sha256", "copy_mode", "attachments"], "properties": {"community_id": {"$ref": "#/$defs/id"}, "channel_id": {"$ref": "#/$defs/id"}, "audience_policy": {"$ref": "#/$defs/id"}, "audience_revision": {"$ref": "#/$defs/id"}, "release_ref": {"$ref": "#/$defs/id"}, "text": {"type": "string", "maxLength": 16384}, "text_sha256": {"$ref": "#/$defs/digest"}, "copy_mode": {"enum": ["summary-link", "explicit-copy"]}, "attachments": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}}}},
    "ack": {"type": "object", "additionalProperties": false, "required": ["cursor", "durable_receipt_id"], "properties": {"cursor": {"type": "string", "minLength": 1, "maxLength": 2048}, "durable_receipt_id": {"$ref": "#/$defs/id"}}}
  }
}
